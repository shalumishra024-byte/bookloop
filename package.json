{
  "name": "bookloop",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm --workspace=bookloop-client run dev",
    "dev:server": "npm --workspace=bookloop-server run dev",
    "build:client": "npm --workspace=bookloop-client run build",
    "build:server": "npm --workspace=bookloop-server run build",
    "build": "npm run build:server && npm run build:client",
    "db:generate": "npm --workspace=bookloop-server run db:generate",
    "db:push": "npm --workspace=bookloop-server run db:push",
    "db:seed": "npm --workspace=bookloop-server run db:seed"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@neon/auth": "^0.8.2",
    "@neon/config": "^1.14.8",
    "@neon/env": "^2.1.11"
  }
}
